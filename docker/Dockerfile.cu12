# TuFT — CUDA 12.8 / 12.9 container for NVIDIA Driver 550+ environments
# Uses official CUDA 12.8 / 12.9 PyTorch and vLLM wheels.
#
# Build:
#   docker build -f docker/Dockerfile.cu12 -t tuft:cu12 .

FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

WORKDIR /workspace

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

RUN chmod 1777 /tmp && apt update && apt install -y --no-install-recommends \
    build-essential \
    curl git wget vim tmux net-tools \
    python3 python3-pip python3-dev python3-packaging python3-venv \
    libomp-dev infiniband-diags libibverbs-dev librdmacm-dev rdma-core perftest \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && ln -sf /usr/bin/pip3 /usr/bin/pip

ENV VIRTUAL_ENV=/root/.tuft/venv
ENV PATH=/root/.tuft/venv/bin:$PATH

# Copy TuFT repository
COPY ./pyproject.toml .
COPY ./LICENSE .
COPY ./README.md .
COPY ./src ./src
COPY ./scripts ./scripts

# Install TuFT with explicit CUDA 12 backend:
# 1. Install torch 2.13.0+cu129 from PyTorch index
# 2. Install vllm 0.27.0+cu129 explicit release wheel
# 3. Install TuFT with --no-deps / dependencies satisfied from cu129
RUN bash ./scripts/install.sh --local-source /workspace --torch-backend cu129 --skip-gpu-checks \
    && . $HOME/.local/bin/env \
    && . /root/.tuft/venv/bin/activate \
    && uv pip install --upgrade "https://github.com/vllm-project/vllm/releases/download/v0.27.0/vllm-0.27.0+cu129-cp38-abi3-manylinux_2_28_x86_64.whl" \
    && uv pip install .[dev] "fla-core>=0.5.0" "flash-linear-attention>=0.4.2" || true

# Verification Gate: Ensure no extensions mistakenly link libcudart.so.13
RUN set -eu; \
    echo "=== Scanning .so files for CUDA 13 ABI contamination ==="; \
    if find /root/.tuft/venv -name '*.so' -exec grep -al 'libcudart\.so\.13' {} + | grep .; then \
      echo "FATAL: Found extension linking libcudart.so.13 on CUDA 12 image!"; \
      exit 1; \
    fi; \
    echo "CUDA 12 validation passed: all extensions link CUDA 12 ABI cleanly."

ENV TUFT_HOST=0.0.0.0 TUFT_PORT=10610
EXPOSE 10610

ENTRYPOINT ["/bin/bash", "-c", "source ${VIRTUAL_ENV}/bin/activate && exec \"$@\"", "--"]
CMD ["bash"]
